{
  "name": "itil5-value-modeller",
  "description": "Builds a value creation model and Mermaid diagrams for a service from source documents, written to models/",
  "prompt": "file://../prompts/itil5-value-modeller.md",
  "tools": ["read", "write", "knowledge"],
  "resources": [
    "file://.kiro/steering/org-context.md",
    "skill://.kiro/skills/value-model/SKILL.md",
    "skill://.kiro/skills/diagram-standards/SKILL.md",
    {
      "type": "knowledgeBase",
      "source": "file://./kb",
      "name": "ITIL5Source",
      "description": "Licensed ITIL (Version 5) reference text, kept locally only",
      "indexType": "best",
      "autoUpdate": true
    }
  ],
  "permissions": {
    "rules": [
      { "capability": "fs_read", "match": ["inbox/**", "kb/**", "samples/**", "models/**", ".kiro/**", "rubric/**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["models/**"], "effect": "allow" },
      { "capability": "fs_write", "match": ["inbox/**", "rubric/**", "kb/**", ".kiro/**", "reviews/**"], "effect": "deny" },
      { "capability": "shell", "match": ["*"], "effect": "deny" },
      { "capability": "web_fetch", "match": ["*"], "effect": "deny" },
      { "capability": "web_search", "match": ["*"], "effect": "deny" }
    ]
  },
  "welcomeMessage": "ITIL 5 value modeller ready. Put source documents in inbox/ and say: model inbox/<file name>"
}
